# Copy this file to .env in the repository root.
# Managed local runtimes should keep configuration outside Git worktrees and point to it explicitly.
# OPENCLASS_ENV_FILE=~/.config/openclass/runtime.env
# Runtime switches preserve the currently exposed auth-provider set by default.
# Optional switch-time invariant for first startup or additional required providers:
# OPENCLASS_REQUIRED_AUTH_PROVIDERS=email,chatgpt
# OPENCLASS_ALLOW_AUTH_PROVIDER_REMOVAL=false
# Local default is apps/api/data/openclass.sqlite3. Use a persistent absolute path in production.
# OPENCLASS_DATABASE_PATH=/var/lib/openclass/openclass.sqlite3
# OPENCLASS_UPLOAD_DIR=/var/lib/openclass/uploads
# OPENCLASS_EXPORT_DIR=/var/lib/openclass/exports
# AI_USAGE_LOG_PATH=/var/lib/openclass/logs/ai-usage.jsonl
# OPENCLASS_REALTIME_ENABLED=false
# OPENCLASS_CODEX_REALTIME_ENABLED=false
# Comma- or space-separated OpenClass user IDs allowed to use the shared platform transport.
# OPENCLASS_CODEX_REALTIME_ALLOWED_USER_IDS=user_123
# OPENCLASS_CODEX_REALTIME_PROXY_URL=http://127.0.0.1:8317/v1/live
# OPENCLASS_CODEX_REALTIME_PROXY_API_KEY_FILE=/etc/cliproxyapi/api-key
# OPENCLASS_PUBLIC_ORIGIN=https://open-classes.com
# OPENCLASS_WEB_ORIGIN=https://open-classes.com
# Exact HTTPS origins for trusted remote profile or media images, separated by commas or spaces.
# OPENCLASS_CSP_IMAGE_SOURCES=https://images.example.com
# Set this on public HTTPS deployments so API responses include HSTS.
# OPENCLASS_ENV=production
# OPENCLASS_ADMIN_EMAILS=teacher@example.com

# Cloudflare Turnstile protects login, registration, and password recovery.
# The site key is public and embedded at web build time; the secret stays backend-only.
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
# OPENCLASS_CLOUDFLARE_TURNSTILE_ENABLED=true
# OPENCLASS_CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# OPENCLASS_CLOUDFLARE_TURNSTILE_EXPECTED_HOSTNAMES=open-classes.com
# OPENCLASS_LOCAL_RUNTIME=false
# NEXT_PUBLIC_OPENCLASS_LOCAL_RUNTIME=false
OPENCLASS_CLOUDFLARE_TURNSTILE_TIMEOUT_SECONDS=5

# Only list reverse proxies that append a sanitized X-Forwarded-For chain.
# Include the loopback proxy plus the current Cloudflare published networks when applicable.
# With no trusted CIDRs, forwarded client-IP headers are ignored.
# OPENCLASS_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Process-local auth limits. Use a shared limiter before running multiple API replicas.
OPENCLASS_LOGIN_RATE_LIMIT_COUNT=10
OPENCLASS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
OPENCLASS_REGISTER_RATE_LIMIT_COUNT=5
OPENCLASS_REGISTER_RATE_LIMIT_WINDOW_SECONDS=900
OPENCLASS_PASSWORD_RECOVERY_RATE_LIMIT_COUNT=5
OPENCLASS_PASSWORD_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=900
# Public support address shown in the web app. NEXT_PUBLIC values are embedded at build time.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@open-classes.com
# Verification email provider option 1: generic SMTP with encrypted delivery.
# Alibaba Mail example: smtp.qiye.aliyun.com, port 465, security ssl.
# Use a third-party client security password, not the normal webmail password.
# OPENCLASS_SMTP_HOST=smtp.qiye.aliyun.com
# OPENCLASS_SMTP_PORT=465
# OPENCLASS_SMTP_SECURITY=ssl
# OPENCLASS_SMTP_USERNAME=login@your-domain.example
# OPENCLASS_SMTP_PASSWORD=third-party-client-security-password
# OPENCLASS_SMTP_FROM_EMAIL=login@your-domain.example
# OPENCLASS_SMTP_FROM_NAME=OpenClass
# Verification email provider option 2: Resend. Replace re_xxxxxxxxx with a newly created API key.
# RESEND_API_KEY=re_xxxxxxxxx
# Use onboarding@resend.dev only for Resend's limited test mode. Production should use a verified domain.
# RESEND_FROM_EMAIL=OpenClass <login@your-verified-domain.example>

# PayPal one-time credit top-ups. Credentials remain backend-only.
# PayPal issues one Credit per paid cent. The value percentage controls how much
# upstream model cost those Credits cover and is never shown in the customer UI.
# OPENCLASS_PAYPAL_MODE=sandbox
# OPENCLASS_PAYPAL_CLIENT_ID=your_paypal_client_id
# OPENCLASS_PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# OPENCLASS_PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
OPENCLASS_PAYPAL_CURRENCY=USD
OPENCLASS_CREDIT_VALUE_PERCENT=75
OPENCLASS_PAYPAL_TOP_UP_USD=5,10,20,50,100
# Defaults to enabled when PayPal credentials are present. Set explicitly for controlled rollout.
# OPENCLASS_CREDIT_BILLING_ENABLED=true
OPENCLASS_MODEL_CALL_RESERVE_CREDITS=25

# Per-user OpenRouter keys for platform-credit text models. Keep provisioning
# disabled until the management key, shared account auto top up, and model map
# have been verified. The management key is administrative and is never used
# for model completion requests.
OPENCLASS_TEXT_MODEL_PROVIDERS=openai_codex
OPENCLASS_REALTIME_MODEL_PROVIDERS=openai_codex
OPENCLASS_OPENROUTER_PROVISIONING_ENABLED=false
# OPENROUTER_MANAGEMENT_API_KEY=your_openrouter_management_api_key
OPENCLASS_OPENROUTER_SYNC_INTERVAL_SECONDS=10
OPENCLASS_OPENROUTER_SAFETY_BUFFER_USD=25
# Defaults beside OPENCLASS_DATABASE_PATH with private 0700/0600 permissions.
# OPENCLASS_OPENROUTER_CREDENTIALS_DIR=/var/lib/openclass/openrouter-credentials
# Keys are "provider:model", "provider:*", "*:model", or "*". Values are
# OpenRouter model IDs. No model is silently substituted when a mapping is absent.
OPENCLASS_OPENROUTER_MODEL_MAP_JSON={}
# Uploaded resource parser: auto uses RAG-Anything for supported complex files when available, then falls back to native.
# OPENCLASS_RESOURCE_PARSER=auto
# Defaults to ./RAG-Anything-main when present, then ../RAG-Anything-main. Override when needed.
# OPENCLASS_RAG_ANYTHING_PATH=RAG-Anything-main
# OPENCLASS_RAG_ANYTHING_PARSER=mineru
# OPENCLASS_RAG_ANYTHING_PARSE_METHOD=auto
# OPENCLASS_RAG_ANYTHING_OUTPUT_DIR=apps/api/data/raganything

# File/material backend. Native keeps original files, directory/body ranges, and local search in OpenClass.
OPENCLASS_SOURCE_BACKEND=native
# native: local text-first parsing, PDF outline/EPUB navigation indexing, and scoped search.
# open_notebook: optional external OpenNotebook-owned parsing, indexing, status, and search.
# OPEN_NOTEBOOK_API_URL=http://localhost:5055
# OPEN_NOTEBOOK_API_PREFIX=/api
# OPEN_NOTEBOOK_PASSWORD=
# OPEN_NOTEBOOK_TIMEOUT_SECONDS=20
# Deterministic directory parsing is authoritative.
OPENCLASS_SOURCE_VISUAL_INDEX_ENABLED=false

# Optional account login providers. Redirect URI format:
# https://your-domain.com/api/auth/oauth/{provider}/callback
# OPENCLASS_OAUTH_GOOGLE_CLIENT_ID=your_google_oauth_client_id
# OPENCLASS_OAUTH_GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# OPENCLASS_OAUTH_APPLE_CLIENT_ID=your_apple_services_id
# OPENCLASS_OAUTH_APPLE_CLIENT_SECRET=your_apple_client_secret_jwt
# OPENCLASS_OAUTH_GITHUB_CLIENT_ID=your_github_oauth_client_id
# OPENCLASS_OAUTH_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# OPENCLASS_OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_oauth_client_id
# OPENCLASS_OAUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_oauth_client_secret
# OPENCLASS_OAUTH_X_CLIENT_ID=your_x_oauth_client_id
# OPENCLASS_OAUTH_X_CLIENT_SECRET=your_x_oauth_client_secret
# Apache Answer is the community system. OpenClass owns identity and learning-context links;
# Answer owns questions, answers, tags, search, reputation, notifications, and moderation.
# OPENCLASS_COMMUNITY_PUBLIC_URL=https://community.example.com
# OPENCLASS_COMMUNITY_INTERNAL_URL=http://answer:80
# Homepage used by the community's back-to-OpenClass navigation.
# OPENCLASS_HOME_URL=https://open-classes.com/home
# Optional override for the community tab icon. Defaults to the favicon at the
# origin inferred from OPENCLASS_HOME_URL.
# OPENCLASS_FAVICON_URL=https://open-classes.com/favicon.ico
# OAuth2 client used only by Apache Answer's connector-basic plugin.
# OPENCLASS_COMMUNITY_OAUTH_CLIENT_ID=openclass-answer
# OPENCLASS_COMMUNITY_OAUTH_CLIENT_SECRET=generate_a_long_random_secret
# Exact Answer callback URL. It must match the connector configuration.
# OPENCLASS_COMMUNITY_OAUTH_REDIRECT_URI=https://community.example.com/answer/api/v1/connector/redirect/basic
# Optional connector endpoint overrides. By default Answer derives these three
# OpenClass OAuth2 endpoints from OPENCLASS_HOME_URL.
# OPENCLASS_COMMUNITY_OAUTH_AUTHORIZE_URL=https://class.example.com/api/auth/community/authorize
# OPENCLASS_COMMUNITY_OAUTH_TOKEN_URL=https://class.example.com/api/auth/community/token
# OPENCLASS_COMMUNITY_OAUTH_USERINFO_URL=https://class.example.com/api/auth/community/userinfo
# Optional Answer image build registry overrides.
# OPENCLASS_ANSWER_GOPROXY=https://proxy.golang.org,direct
# OPENCLASS_ANSWER_NPM_REGISTRY=https://registry.npmjs.org
# Optional same-origin UI mount path. Rebuilding the Answer image is required
# after changing this value.
# OPENCLASS_ANSWER_BASE_PATH=/community
# Optional build-time Node.js heap limit for low-memory deployment hosts.
# OPENCLASS_ANSWER_NODE_OPTIONS=--max-old-space-size=1536
# Apply the warm OpenClass visual theme to Answer after startup.
# OPENCLASS_ANSWER_THEME_ENABLED=true
# Optional unattended Answer installation. The bootstrap administrator must use
# a service-only email that is not assigned to any OpenClass user.
# OPENCLASS_ANSWER_AUTO_INSTALL=true
# OPENCLASS_ANSWER_BOOTSTRAP_ADMIN_EMAIL=answer-admin@openclass.local
# OPENCLASS_ANSWER_BOOTSTRAP_ADMIN_NAME=openclassadmin
# OPENCLASS_ANSWER_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-password
# OPENCLASS_ANSWER_CONTACT_EMAIL=community@example.com

# Pi Agent is the server-owned runtime for Studio teaching and source-directory tasks.
# Point this at an operator-managed Pi directory that contains auth.json. Production
# deployments should use an isolated directory rather than the developer's personal Pi home.
# OPENCLASS_PI_BINARY=/absolute/path/to/pi
# OPENCLASS_PI_AGENT_DIR=/var/lib/openclass/pi-agent
# OPENCLASS_PI_SOURCE_TIMEOUT_SECONDS=900
# The Codex app-server remains disabled unless an operator explicitly needs the rollback adapter.
OPENCLASS_CODEX_APP_SERVER_ENABLED=false
# Explicitly allow ChatGPT device login to create or link an OpenClass account.
# Keep this false on multi-tenant deployments; Settings can still connect Codex separately.
OPENCLASS_CHATGPT_PLATFORM_LOGIN_ENABLED=false
# OPENCLASS_CODEX_CLI_PATH=/absolute/path/to/codex
# Optional executable shell for isolated Codex rollback commands. Defaults to the first
# available shell from SHELL, /bin/zsh, /bin/bash, or /bin/sh.
# OPENCLASS_CODEX_SHELL=/bin/sh
# Absolute Poppler root containing bin/pdfinfo, bin/pdftotext, and bin/pdftoppm.
# PDF Source Codex tasks fail before model execution when this toolchain is unavailable.
# OPENCLASS_POPPLER_ROOT=/absolute/path/to/poppler
# Legacy Codex rollback state, kept outside the repository when explicitly enabled.
# OPENCLASS_CODEX_HOME=~/.openclass/codex
# OPENCLASS_CODEX_WORKSPACE_ROOT=~/.openclass/codex-workspaces
# OPENCLASS_CODEX_BOARD_MAX_BYTES=2097152
# OPENAI_CODEX_MODEL=gpt-5.5

# OpenAI Realtime voice and text. The standard API key stays on the backend.
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENCLASS_REALTIME_ENABLED=false
OPENCLASS_REALTIME_TOOLS_ENABLED=true
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Shared DeepSeek text provider. One backend key is available to guest, user, and admin roles.
# OpenClass does not enforce a per-user DeepSeek balance or call limit; upstream provider limits
# and the account's actual billing still apply. Keep this key only on the backend.
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_SECONDS=120
# DEEPSEEK_MAX_TOKENS=

# Optional cross-platform OCR fallback for scanned documents. Install the
# Tesseract executable and the language packs listed here on the runtime host.
# OPENCLASS_TESSERACT_BINARY=tesseract
# OPENCLASS_TESSERACT_LANGUAGES=eng

# Optional text-to-speech playback for completed Chatbot replies.
# Choose one backend adapter. Keep credentials on the backend; never expose them
# through NEXT_PUBLIC_* variables.
# OPENCLASS_SPEECH_PROVIDER=volcengine
# VOLCENGINE_TTS_API_KEY=your_volcengine_speech_api_key
# VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
# VOLCENGINE_TTS_SPEAKER=zh_female_vv_uranus_bigtts
# VOLCENGINE_TTS_SAMPLE_RATE=24000
# VOLCENGINE_TTS_SPEECH_RATE=0
# VOLCENGINE_TTS_TIMEOUT_SECONDS=30

# OpenAI speech. This reuses the backend OPENAI_API_KEY above; no second key is
# required. Set OPENCLASS_SPEECH_PROVIDER=openai to select this adapter.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin
# OPENAI_TTS_SPEECH_RATE=0
# OPENAI_TTS_INSTRUCTIONS=
# OPENAI_TTS_TIMEOUT_SECONDS=30
# OPENAI_TTS_ENDPOINT=https://api.openai.com/v1/audio/speech

# Google Cloud Standard and WaveNet voices. Enable the Cloud Text-to-Speech API,
# restrict the API key to that API, then set OPENCLASS_SPEECH_PROVIDER=google_cloud.
# An OAuth access token can replace the API key for short-lived server sessions.
# GOOGLE_CLOUD_TTS_API_KEY=your_restricted_google_cloud_api_key
# GOOGLE_CLOUD_TTS_ACCESS_TOKEN=
# GOOGLE_CLOUD_TTS_PROJECT_ID=your_google_cloud_project_id
# GOOGLE_CLOUD_TTS_ENDPOINT=https://texttospeech.googleapis.com/v1/text:synthesize
# GOOGLE_CLOUD_TTS_VOICES_ENDPOINT=https://texttospeech.googleapis.com/v1/voices
# GOOGLE_CLOUD_TTS_VOICE=cmn-CN-Standard-A
# GOOGLE_CLOUD_TTS_SPEECH_RATE=0
# GOOGLE_CLOUD_TTS_TIMEOUT_SECONDS=30
